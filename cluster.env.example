# Copy to cluster.env and customize for your cluster.
# cluster.env is gitignored — safe for private paths, email, and account names.
#
#   cp cluster.env.example cluster.env

# Project root (default: auto-detected from repo if unset)
# EVENTS_DIR=/path/to/STRIVE-EACL

# vLLM model weights directory (contains .venv for model serving)
MODEL_DIR=/path/to/models

# SLURM billing account and job notification email
# Used by slurm_jobs/run.sh --submit
SLURM_ACCOUNT=your-slurm-account
SLURM_MAIL_USER=you@example.com

# Pitt CRC uses the "gpu" cluster. Set an empty value to use your default cluster.
# SLURM_GPU_CLUSTER=gpu
